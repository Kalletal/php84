#!/bin/sh
# PHP 8.4.15 Post-installation Script
# POSIX-compliant - No external commands like sed, awk, grep

# Package paths (provided by DSM during installation)
SYNOPKG_PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/php84/target}"
SYNOPKG_PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/php84/var}"
SYNOPKG_PKGNAME="${SYNOPKG_PKGNAME:-php84}"

# Configuration paths
CONF_DIR="${SYNOPKG_PKGVAR}/etc"
CONF_D_DIR="${CONF_DIR}/conf.d"
USER_CONFIG="${SYNOPKG_PKGVAR}/config.json"
LOG_FILE="${SYNOPKG_PKGVAR}/log/install.log"

# Extension directory
EXT_DIR="${SYNOPKG_PKGDEST}/lib/php/extensions/no-debug-non-zts-20240924"

# Logging function
log() {
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "[postinst] $1" >> "${LOG_FILE}" 2>/dev/null
    echo "$1"
}

# Create necessary directories
create_directories() {
    log "Creating configuration directories..."
    mkdir -p "${CONF_DIR}"
    mkdir -p "${CONF_D_DIR}"
    mkdir -p "${SYNOPKG_PKGVAR}/log"
    mkdir -p "${SYNOPKG_PKGVAR}/run"
    mkdir -p "${SYNOPKG_PKGVAR}/tmp"

    # CRITICAL: Allow 'http' user (CGI executor) to write extension configs
    # CGI scripts in DSM 7 run as 'http' user, not the package user (sc-php84)
    # Without this, the Extension Manager UI cannot enable/disable extensions
    chmod 777 "${CONF_D_DIR}"
    log "Set conf.d permissions to 777 for CGI access"
}

# Initialize php.ini
init_php_ini() {
    log "Initializing php.ini..."

    if [ ! -f "${CONF_DIR}/php.ini" ]; then
        # Create php.ini from scratch with essential settings
        cat > "${CONF_DIR}/php.ini" << EOF
[PHP]
; PHP 8.4.15 Configuration for Synology DSM

; Extension directory
extension_dir = "${EXT_DIR}"

; Scan directory for additional .ini files
; Note: DSM uses conf.d pattern

; Basic settings
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1

; Error handling
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = ${SYNOPKG_PKGVAR}/log/php_errors.log
log_errors_max_len = 1024
ignore_repeated_errors = Off
ignore_repeated_source = Off
report_memleaks = On

; Resource limits
max_execution_time = 60
max_input_time = 60
memory_limit = 256M

; Data handling
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
auto_globals_jit = On
post_max_size = 64M
default_mimetype = "text/html"
default_charset = "UTF-8"

; File uploads
file_uploads = On
upload_max_filesize = 64M
max_file_uploads = 20

; Paths and directories
doc_root =
user_dir =
enable_dl = Off

; cgi.fix_pathinfo provides *real* PATH_INFO/PATH_TRANSLATED support for CGI
cgi.fix_pathinfo = 0

; Timezone
date.timezone = "UTC"

; Session
session.save_handler = files
session.save_path = "${SYNOPKG_PKGVAR}/tmp"
session.use_strict_mode = 1
session.use_cookies = 1
session.use_only_cookies = 1
session.name = PHPSESSID
session.auto_start = 0
session.cookie_lifetime = 0
session.cookie_path = /
session.cookie_domain =
session.cookie_httponly = 1
session.cookie_samesite = "Lax"
session.serialize_handler = php
session.gc_probability = 1
session.gc_divisor = 1000
session.gc_maxlifetime = 1440
session.sid_length = 32
session.sid_bits_per_character = 5

; Scan directory for conf.d
EOF
    fi
}

# Initialize php-fpm.conf
init_php_fpm_conf() {
    log "Initializing php-fpm.conf..."

    if [ ! -f "${CONF_DIR}/php-fpm.conf" ]; then
        cat > "${CONF_DIR}/php-fpm.conf" << EOF
[global]
pid = ${SYNOPKG_PKGVAR}/run/php-fpm.pid
error_log = ${SYNOPKG_PKGVAR}/log/php-fpm.log
log_level = notice
daemonize = yes

include=${CONF_DIR}/php-fpm.d/*.conf
EOF
    fi

    # Create pool directory and default pool
    mkdir -p "${CONF_DIR}/php-fpm.d"
    if [ ! -f "${CONF_DIR}/php-fpm.d/www.conf" ]; then
        # PHP-FPM pool configuration
        # user/group are required when PHP-FPM master is started as root
        # DSM starts services via root, so we must specify the package user
        cat > "${CONF_DIR}/php-fpm.d/www.conf" << EOF
[www]
; Run workers as the package user
user = ${SYNOPKG_PKGNAME}
group = ${SYNOPKG_PKGNAME}

; Socket in package var directory
listen = ${SYNOPKG_PKGVAR}/run/php-fpm.sock
listen.owner = ${SYNOPKG_PKGNAME}
listen.group = ${SYNOPKG_PKGNAME}
listen.mode = 0666

; Process manager settings
pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

; Logging
slowlog = ${SYNOPKG_PKGVAR}/log/php-fpm.slow.log
request_slowlog_timeout = 30s
catch_workers_output = yes
decorate_workers_output = no
EOF
    fi
}

# Enable a specific extension by creating its .ini file
# Extensions are prefixed with numbers to control load order
enable_extension() {
    ext_name="$1"
    ext_file="${ext_name}.so"

    # Determine load order prefix based on dependencies
    # MUST match index.cgi logic for consistency!
    # 20- = Core extensions that others depend on (load first)
    # 50- = Standard extensions (default)
    # 70- = Extensions that depend on core extensions (load last)
    case "$ext_name" in
        # Core extensions that others depend on - load FIRST (20-)
        session|sockets|mysqlnd|pdo|igbinary)
            prefix="20" ;;
        # Extensions that depend on core extensions - load LAST (70-)
        ev|event|msgpack|mysqli|pdo_mysql|redis|memcached)
            prefix="70" ;;
        # All other extensions (50-)
        *)
            prefix="50" ;;
    esac

    ini_file="${CONF_D_DIR}/${prefix}-${ext_name}.ini"

    # Check if extension file exists
    if [ -f "${EXT_DIR}/${ext_file}" ]; then
        # Zend extensions (opcache, xdebug)
        case "$ext_name" in
            opcache|xdebug)
                echo "zend_extension=${ext_file}" > "${ini_file}"
                ;;
            *)
                echo "extension=${ext_file}" > "${ini_file}"
                ;;
        esac

        # Extension-specific configuration
        case "$ext_name" in
            opcache)
                cat >> "${ini_file}" << 'EOF'
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption=128
opcache.interned_strings_buffer=8
opcache.max_accelerated_files=10000
opcache.revalidate_freq=2
opcache.fast_shutdown=1
EOF
                ;;
            apcu)
                cat >> "${ini_file}" << 'EOF'
apc.enabled=1
apc.shm_size=32M
apc.ttl=7200
apc.enable_cli=0
EOF
                ;;
            xdebug)
                cat >> "${ini_file}" << 'EOF'
xdebug.mode=off
xdebug.start_with_request=no
xdebug.client_host=localhost
xdebug.client_port=9003
EOF
                ;;
        esac

        log "Enabled extension: $ext_name"
        return 0
    else
        log "Extension not found: $ext_file"
        return 1
    fi
}

# Process wizard selections based on profile
# Wizard variables: wizard_profile_minimal, wizard_profile_standard, wizard_profile_complete
# Plus optional extensions: wizard_min_*, wizard_std_*
process_wizard_selections() {
    log "Processing wizard profile selection..."

    # DEBUG: Log wizard environment variables
    log "DEBUG: wizard_profile_minimal=$wizard_profile_minimal"
    log "DEBUG: wizard_profile_standard=$wizard_profile_standard"
    log "DEBUG: wizard_profile_complete=$wizard_profile_complete"
    log "DEBUG: SYNOPKG_PKG_STATUS=$SYNOPKG_PKG_STATUS"

    # T013: Preserve existing extensions on upgrade
    if [ "$SYNOPKG_PKG_STATUS" = "UPGRADE" ]; then
        log "UPGRADE detected - preserving existing extension configuration"
        # On upgrade, don't touch conf.d - keep existing .ini files
        return 0
    fi

    # CRITICAL: Clean conf.d for fresh install (DSM doesn't delete var/ on uninstall)
    # This ensures old .ini files from previous installations are removed
    log "Fresh install - cleaning conf.d directory"
    rm -f "${CONF_D_DIR}"/*.ini 2>/dev/null
    log "Cleaned old extension configurations"

    # Initialize user config
    cat > "${USER_CONFIG}" << 'EOF'
{
  "version": "1.0",
  "php_version": "8.4.15",
  "extensions": {},
  "settings": {
    "memory_limit": "256M",
    "max_execution_time": 60,
    "upload_max_filesize": "64M",
    "post_max_size": "64M",
    "timezone": "UTC"
  }
}
EOF

    # Determine selected profile
    # IMPORTANT: Minimal and Standard profiles do NOT enable base extensions automatically
    # Only explicitly selected extensions are enabled (fix for bug 003)
    if [ "$wizard_profile_complete" = "true" ]; then
        log "Profile: COMPLETE - Enabling all extensions"
        enable_profile_complete
    elif [ "$wizard_profile_minimal" = "true" ]; then
        log "Profile: MINIMAL - No base extensions (only selected ones)"
        # DO NOT call enable_profile_minimal() - no default extensions
        process_minimal_extensions
    else
        # Default to standard (wizard_profile_standard = true or fallback)
        log "Profile: STANDARD - No base extensions (only selected ones)"
        # DO NOT call enable_profile_standard() - no default extensions
        process_standard_extensions
    fi
}

# Profile: Minimal - Essential extensions only
enable_profile_minimal() {
    log "Enabling minimal profile extensions..."
    enable_extension "opcache"
    enable_extension "session"
    enable_extension "filter"
    enable_extension "ctype"
    enable_extension "pdo"
    enable_extension "curl"
    enable_extension "openssl"
}

# Profile: Standard - Common extensions for web apps
enable_profile_standard() {
    log "Enabling standard profile extensions..."
    # Core
    enable_extension "opcache"
    enable_extension "session"
    enable_extension "filter"
    enable_extension "ctype"
    enable_extension "fileinfo"
    enable_extension "tokenizer"
    enable_extension "phar"
    # Database
    enable_extension "pdo"
    enable_extension "pdo_mysql"
    enable_extension "mysqli"
    enable_extension "mysqlnd"
    enable_extension "pdo_sqlite"
    enable_extension "sqlite3"
    # Network
    enable_extension "curl"
    enable_extension "openssl"
    # Text
    enable_extension "mbstring"
    enable_extension "iconv"
    enable_extension "intl"
    # XML
    enable_extension "xml"
    enable_extension "dom"
    enable_extension "simplexml"
    # Compression
    enable_extension "zip"
    enable_extension "zlib"
    # Image & Math
    enable_extension "gd"
    enable_extension "bcmath"
    enable_extension "sodium"
}

# Profile: Complete - All extensions
enable_profile_complete() {
    log "Enabling complete profile - all extensions..."
    # Enable all available extensions
    for ext_file in "${EXT_DIR}"/*.so; do
        if [ -f "$ext_file" ]; then
            ext_name=$(basename "$ext_file" .so)
            enable_extension "$ext_name"
        fi
    done
}

# Process optional extensions for Minimal profile
# Uses wizard_min_* variables from wizard
# Default: 7 most popular extensions (opcache, mbstring, pdo, pdo_mysql, curl, openssl, gd)
process_minimal_extensions() {
    log "Processing Minimal profile extensions..."

    # Enable mysqlnd if pdo_mysql is selected (dependency)
    if [ "$wizard_min_pdo_mysql" = "true" ]; then
        enable_extension "mysqlnd"
    fi

    # 7 essential extensions (pre-selected by default)
    [ "$wizard_min_opcache" = "true" ] && enable_extension "opcache"
    [ "$wizard_min_mbstring" = "true" ] && enable_extension "mbstring"
    [ "$wizard_min_pdo" = "true" ] && enable_extension "pdo"
    [ "$wizard_min_pdo_mysql" = "true" ] && enable_extension "pdo_mysql"
    [ "$wizard_min_curl" = "true" ] && enable_extension "curl"
    [ "$wizard_min_openssl" = "true" ] && enable_extension "openssl"
    [ "$wizard_min_gd" = "true" ] && enable_extension "gd"
}

# Process extensions for Standard profile
# Uses wizard_std_* variables from wizard
# 11 web extensions (10 pre-selected + opcache optional)
process_standard_extensions() {
    log "Processing Standard profile extensions..."

    # Enable mysqlnd if pdo_mysql is selected (dependency)
    if [ "$wizard_std_pdo_mysql" = "true" ]; then
        enable_extension "mysqlnd"
    fi

    # 11 web essential extensions (10 pre-selected by default)
    [ "$wizard_std_opcache" = "true" ] && enable_extension "opcache"
    [ "$wizard_std_pdo" = "true" ] && enable_extension "pdo"
    [ "$wizard_std_pdo_mysql" = "true" ] && enable_extension "pdo_mysql"
    [ "$wizard_std_mbstring" = "true" ] && enable_extension "mbstring"
    [ "$wizard_std_curl" = "true" ] && enable_extension "curl"
    [ "$wizard_std_openssl" = "true" ] && enable_extension "openssl"
    [ "$wizard_std_gd" = "true" ] && enable_extension "gd"
    [ "$wizard_std_tokenizer" = "true" ] && enable_extension "tokenizer"
    [ "$wizard_std_bcmath" = "true" ] && enable_extension "bcmath"
    [ "$wizard_std_xml" = "true" ] && enable_extension "xml"
    [ "$wizard_std_zip" = "true" ] && enable_extension "zip"
}

# Set proper permissions
# Note: DSM 7 manages ownership and permissions automatically
# For non-root packages, we should NOT use chmod on system directories
# Files in SYNOPKG_PKGVAR are owned by the package user
set_permissions() {
    log "Setting permissions (non-root mode)..."
    # DSM 7 handles permissions automatically for non-root packages
    # No chmod operations needed - files are created with correct permissions
    # Binary permissions are preserved from package.tgz
    log "Permissions managed by DSM"
}

# Setup PHP wrapper with LD_LIBRARY_PATH
# This ensures PHP can find bundled libraries (libgd, libicu, etc.)
setup_php_wrapper() {
    log "Setting up PHP wrapper..."
    BIN_DIR="${SYNOPKG_PKGDEST}/bin"

    # Only setup if not already done (php.bin doesn't exist yet)
    if [ -f "${BIN_DIR}/php" ] && [ ! -f "${BIN_DIR}/php.bin" ]; then
        # Rename original binary
        mv "${BIN_DIR}/php" "${BIN_DIR}/php.bin"

        # Rename wrapper to php
        if [ -f "${BIN_DIR}/php-wrapper" ]; then
            mv "${BIN_DIR}/php-wrapper" "${BIN_DIR}/php"
            chmod 755 "${BIN_DIR}/php"
            log "PHP wrapper installed successfully"
        else
            # Fallback: create wrapper if missing
            cat > "${BIN_DIR}/php" << 'WRAPPER'
#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PKG_DIR="$(dirname "$SCRIPT_DIR")"
export LD_LIBRARY_PATH="${PKG_DIR}/lib:${LD_LIBRARY_PATH}"
exec "${SCRIPT_DIR}/php.bin" "$@"
WRAPPER
            chmod 755 "${BIN_DIR}/php"
            log "PHP wrapper created (fallback)"
        fi
    else
        log "PHP wrapper already configured"
    fi
}

# Create symlinks for convenience
# Note: System-wide symlinks in /usr/local/bin require root privileges
# which are not available in non-root packages. Users can create these
# manually if needed: ln -s /var/packages/php84/target/bin/php /usr/local/bin/php84
create_symlinks() {
    log "Skipping system symlinks (non-root package)"
    log "PHP binary available at: ${SYNOPKG_PKGDEST}/bin/php"
}

# Main installation process
main() {
    log "=========================================="
    log "PHP 8.4.15 Post-installation starting..."
    log "=========================================="

    create_directories
    init_php_ini
    init_php_fpm_conf
    process_wizard_selections
    set_permissions
    setup_php_wrapper
    create_symlinks

    log "=========================================="
    log "Post-installation completed successfully!"
    log "=========================================="

    exit 0
}

# Run main
main "$@"
